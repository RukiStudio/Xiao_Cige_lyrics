# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production (but keep build/icon.ico and build/installer.nsh for electron-builder)
/build/*
!/build/icon.ico
!/build/installer.nsh

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# electron build output
/release/
/.electron-cache/
/.eb-cache/

# large binary artifacts (exceed GitHub 100MB limit, use Releases instead)
*.exe
*.msi

# generated docs screenshots (optional, can comment out to include)
# /docs/screenshots/

# build artifacts
/build/icon-source.jpg

# python
__pycache__/
*.pyc

# os
Thumbs.db
